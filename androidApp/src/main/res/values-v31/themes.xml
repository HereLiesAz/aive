<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ system splash: intentionally neutral so no static/legacy logo flashes before video. -->
    <style name="Theme.Haive.Splash" parent="Theme.Haive">
        <item name="android:windowSplashScreenBackground">@color/haive_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/haive_icon_background</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
