<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer scope. Credentials are Keystore-encrypted and cannot be
  decrypted on another device, so they are never backed up. Downloaded models are large and
  re-downloadable. Workflow state, settings and the agent-memory databases are kept. Keep in sync
  with backup_rules.xml and docs/PRIVACY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="haive.credentials.xml" />
        <exclude domain="sharedpref" path="haive.repository.credentials.xml" />
        <exclude domain="sharedpref" path="haive.distributed-compute.credentials.xml" />
        <exclude domain="sharedpref" path="aive.remote-relay.credentials.xml" />
        <exclude domain="sharedpref" path="aive.remote-relay.settings.xml" />
        <exclude domain="file" path="haive/memory" />
        <exclude domain="file" path="haive/orchestration-specialists" />
        <exclude domain="file" path="azphalt/models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="haive.credentials.xml" />
        <exclude domain="sharedpref" path="haive.repository.credentials.xml" />
        <exclude domain="sharedpref" path="haive.distributed-compute.credentials.xml" />
        <exclude domain="sharedpref" path="aive.remote-relay.credentials.xml" />
        <exclude domain="sharedpref" path="aive.remote-relay.settings.xml" />
        <exclude domain="file" path="haive/memory" />
        <exclude domain="file" path="haive/orchestration-specialists" />
        <exclude domain="file" path="azphalt/models" />
    </device-transfer>
</data-extraction-rules>
